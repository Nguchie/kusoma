# Copy to .env.local and fill in values. Never commit .env.local.
# Keys: Implementation Guide Step 1.3 / System design §14.

# --- Supabase (Phase 1 required — Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (Phase 2 required) ---
ANTHROPIC_API_KEY=

# --- CBC Curriculum API (Phase 2 required) ---
CBC_API_URL=
CBC_API_KEY=

# --- Redis (Phase 2 session store + Phase 4 jobs) ---
REDIS_URL=

# --- M-Pesa Daraja (out of scope this build; leave blank) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Chat rate limits (system design §12.4) ---
CHAT_MIN_SECONDS_BETWEEN_MESSAGES=3
CHAT_DAILY_MESSAGE_CAP=80

# --- Signed student chat cookie (Phase 2 required) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_SESSION_SECRET=
