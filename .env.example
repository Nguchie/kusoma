# Copy to .env.local and fill in values. Never commit .env.local.
# Keys: Implementation Guide Step 1.3 / System design §14.

# --- Supabase (Phase 1 required — Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL: transaction pooler (port 6543) for the Next.js app.
# DATABASE_DIRECT_URL: session pooler (port 5432, user postgres.<project-ref>) for drizzle-kit.
# Prefer the session pooler over db.<ref>.supabase.co — that host is IPv6-only.
# Quote the values. URL-encode special characters in the password (e.g. # → %23).
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- LLM: Amazon Bedrock (Claude Sonnet 4.6). No Anthropic API. ---
# IAM user/role with bedrock:InvokeModel in this region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Optional: temporary creds
# AWS_SESSION_TOKEN=
# Optional: Bedrock API key instead of IAM (if your account uses it)
# AWS_BEARER_TOKEN_BEDROCK=
# Default: global.anthropic.claude-sonnet-4-6
# If global CRIS is not enabled, try eu.anthropic.claude-sonnet-4-6 or us.anthropic.claude-sonnet-4-6
# CLAUDE_MODEL=global.anthropic.claude-sonnet-4-6

# --- CBC Curriculum API (Phase 2 required) ---
CBC_API_URL=
CBC_API_KEY=

# --- Redis (Phase 2 session store + Phase 4 jobs) ---
# Local: brew services start redis   then REDIS_URL=redis://127.0.0.1:6379
# Worker (Phase 4, not inside next dev): npm run worker
# One-shot: npm run worker:once -- practice_nudge|weekly_report|payment_reminder
# Hosted: Upstash or Render Redis (rediss://…). Do not run workers in the web process.
REDIS_URL=

# --- M-Pesa Daraja (out of scope this build; leave blank) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Chat rate limits (system design §12.4) ---
CHAT_MIN_SECONDS_BETWEEN_MESSAGES=3
CHAT_DAILY_MESSAGE_CAP=80

# --- Signed student chat cookie (Phase 2 required) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HMAC-signed httpOnly cookie; payload lives in Redis (12h TTL).
CHAT_SESSION_SECRET=
